/* =========================================================
   TUX POS — MAIN CSS
   PREMIUM DARK MODE
   ========================================================= */

:root {
  --tux-bg: #0b0f14;
  --tux-bg-deep: #080b0f;
  --tux-panel: #0e1217;
  --tux-panel-2: #12171d;
  --tux-card: #12161b;
  --tux-card-hover: #191e24;
  --tux-input: #0a0d11;
  --tux-border: #242a31;
  --tux-border-light: #303740;
  --tux-border-soft: #202832;
  --tux-text: #f5f7fa;
  --tux-text-soft: #c5ccd5;
  --tux-muted: #8d98a6;
  --tux-muted-dark: #687381;
  --tux-red: #e5484d;
  --tux-red-hover: #f05a5f;
  --tux-red-dark: #b9363b;
  --tux-yellow: #f5c451;
  --tux-yellow-hover: #ffd166;
  --tux-green: #35c759;
  --tux-green-dark: #249a42;
  --tux-blue: #3b82f6;
  --tux-blue-hover: #5595ff;
  --tux-danger: #ef4444;
  --tux-purple: #9b6cff;
  --tux-shadow: rgba(0, 0, 0, 0.35);
  --tux-shadow-heavy: rgba(0, 0, 0, 0.55);
}

/* =========================================================
   RESET
   ========================================================= */

* {
  box-sizing: border-box;
}

html,
body {
  width: 100%;
  height: 100%;
  margin: 0;
  height: 1500px;
}

body {
  font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
  background: var(--tux-bg);
  color: var(--tux-text);
  padding: 6px;
  direction: ltr;
  overflow: auto;
  display: flex;
  flex-direction: column;
  gap: 6px;
  -webkit-font-smoothing: antialiased;
}

/* =========================================================
   SCROLLBARS
   ========================================================= */

* {
  scrollbar-width: thin;
  scrollbar-color: #3a4654 transparent;
}

*::-webkit-scrollbar {
  width: 7px;
  height: 7px;
}

*::-webkit-scrollbar-track {
  background: transparent;
}

*::-webkit-scrollbar-thumb {
  background: #3a4654;
  border-radius: 10px;
}

*::-webkit-scrollbar-thumb:hover {
  background: #4a5868;
}

/* =========================================================
   TOP NAVIGATION
   ========================================================= */

.top-nav {
  flex: 0 0 auto;
  min-height: 46px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  background: var(--tux-panel);
  padding: 6px 10px;
  border-radius: 7px;
  border: 1px solid var(--tux-border);
  box-shadow: 0 3px 12px var(--tux-shadow);
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 16px;
  font-weight: 800;
  color: var(--tux-text);
  white-space: nowrap;
}

.nav-brand span {
  color: var(--tux-red);
}

.nav-tabs {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-wrap: wrap;
}

.nav-btn {
  min-height: 34px;
  background: #171d25;
  border: 1px solid transparent;
  color: var(--tux-muted);
  padding: 7px 11px;
  border-radius: 5px;
  font-weight: 700;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  font-size: 11px;
  transition:
    background 0.15s ease,
    color 0.15s ease,
    border-color 0.15s ease,
    transform 0.1s ease;
}

.nav-btn:hover:not(.active) {
  background: var(--tux-card-hover);
  color: var(--tux-text);
  border-color: var(--tux-border-light);
}

.nav-btn:active {
  transform: translateY(1px);
}

.nav-btn.active {
  background: var(--tux-red);
  color: #fff;
  border-color: var(--tux-red);
  box-shadow: 0 3px 10px rgba(229, 72, 77, 0.22);
}

.nav-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
  transform: none;
}

.nav-clock {
  min-width: 75px;
  font-size: 11px;
  color: var(--tux-muted);
  text-align: right;
  white-space: nowrap;
}

/* =========================================================
   STAFF LOGIN
   ========================================================= */

.staff-login-box {
  display: flex;
  align-items: center;
  gap: 5px;
  background: var(--tux-card);
  border: 1px solid var(--tux-border);
  border-radius: 6px;
  padding: 4px 6px;
  max-width: 280px;
  min-height: 34px;
}

.staff-status {
  font-size: 10px;
  font-weight: 800;
  color: var(--tux-red);
  white-space: nowrap;
  max-width: 150px;
  overflow: hidden;
  text-overflow: ellipsis;
}

.staff-status.logged-in {
  color: var(--tux-green);
}

.staff-login-btn,
.staff-logout-btn {
  min-height: 28px;
  border: none;
  color: white;
  padding: 5px 9px;
  border-radius: 5px;
  cursor: pointer;
  font-size: 10px;
  font-weight: 800;
  transition:
    opacity 0.15s ease,
    transform 0.1s ease;
}

.staff-login-btn {
  background: var(--tux-green-dark);
}

.staff-logout-btn {
  background: var(--tux-red-dark);
  display: none;
}

.staff-login-btn:hover,
.staff-logout-btn:hover {
  opacity: 0.88;
}

.staff-login-btn:active,
.staff-logout-btn:active {
  transform: translateY(1px);
}

/* =========================================================
   VIEWS
   ========================================================= */

.view-section {
  display: none;
  flex: 1 1 auto;
  min-height: 0;
  height: auto;
  flex-direction: column;
  gap: 7px;
  overflow: hidden;
}

.view-section.active {
  display: flex;
}

/* =========================================================
   POS LAYOUT
   ========================================================= */

.pos-container {
  display: flex;
  gap: 7px;
  width: 100%;
  height: 100%;
  min-height: 0;
  overflow: hidden;
}

/* =========================================================
   MENU PANEL
   ========================================================= */

.menu-panel {
  width: 68%;
  min-width: 0;
  min-height: 0;
  background: var(--tux-panel);
  border-radius: 7px;
  padding: 7px;
  display: flex;
  flex-direction: column;
  gap: 6px;

  /* View Board scrolling */
  overflow-y: auto;
  overflow-x: hidden;

  border: 1px solid var(--tux-border);
  box-shadow: 0 3px 12px var(--tux-shadow);
}

.section-title {
  background: var(--tux-red);
  color: #fff;
  padding: 6px 8px;
  min-height: 29px;
  font-size: 11.5px;
  font-weight: 800;
  letter-spacing: 0.2px;
  border-radius: 4px;
  display: flex;
  align-items: center;
  gap: 5px;
  margin-top: 3px;
  flex-shrink: 0;
  box-shadow: 0 2px 7px rgba(229, 72, 77, 0.15);
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 5px;
}

.item-card {
  background: var(--tux-card);
  border: 1px solid var(--tux-border);
  border-radius: 5px;
  padding: 7px 5px;
  text-align: center;
  cursor: pointer;
  transition:
    background 0.12s ease,
    border-color 0.12s ease,
    transform 0.1s ease,
    box-shadow 0.12s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  min-height: 55px;
  user-select: none;
}

.item-card:hover {
  background: var(--tux-card-hover);
  border-color: var(--tux-border-light);
  box-shadow: 0 3px 8px var(--tux-shadow);
}

.item-card:active {
  transform: scale(0.98);
}

.item-card[draggable="true"] {
  cursor: grab;
}

.item-card:active[draggable="true"] {
  cursor: grabbing;
}

.item-card.dragging {
  opacity: 0.4;
  border: 2px dashed var(--tux-red);
}

.item-card.drag-over {
  border-color: var(--tux-yellow);
  background: #242a31;
  box-shadow: 0 0 0 1px rgba(245, 196, 81, 0.2);
}

.item-name {
  font-size: 10.5px;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 1.15;
  color: var(--tux-text);
}

.item-price {
  font-size: 10.5px;
  color: var(--tux-yellow);
  font-weight: 800;
  line-height: 1.1;
}

/* =========================================================
   RIGHT PANEL
   ========================================================= */

.right-panel {
  width: 32%;
  min-width: 300px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  height: 100%;
  min-height: 0;
  overflow: hidden;
}

.extras-panel {
  flex: 0 0 auto;
  max-height: 28%;
  background: var(--tux-panel);
  border-radius: 7px;
  padding: 6px;
  border: 1px solid var(--tux-border);
  overflow-y: auto;
  overflow-x: hidden;
  box-shadow: 0 3px 12px var(--tux-shadow);
}

.order-panel {
  flex: 1 1 auto;
  min-height: 0;
  background: var(--tux-panel);
  border-radius: 7px;
  padding: 7px;
  display: flex;
  flex-direction: column;
  border: 1px solid var(--tux-border);
  overflow: hidden;
  box-shadow: 0 3px 12px var(--tux-shadow);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 6px;
  border-bottom: 1px solid var(--tux-border);
  padding-bottom: 6px;
  margin-bottom: 5px;
  flex-shrink: 0;
}

.order-header h2 {
  margin: 0;
  color: var(--tux-text);
  font-size: 13px;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 5px;
}

.cart-table-header {
  display: flex;
  justify-content: space-between;
  font-size: 10px;
  font-weight: 800;
  color: var(--tux-muted);
  padding: 3px 4px;
  border-bottom: 1px solid var(--tux-border-soft);
  flex-shrink: 0;
}

.cart-box {
  flex: 1 1 auto;
  min-height: 70px;
  background: var(--tux-bg-deep);
  border-radius: 5px;
  padding: 5px;
  overflow-y: auto;
  overflow-x: hidden;
  border: 1px solid var(--tux-border);
  margin-bottom: 5px;
}

.cart-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 4px;
  padding: 6px 3px;
  border-bottom: 1px solid var(--tux-border-soft);
  font-size: 10.5px;
  font-weight: 700;
}

.cart-item:last-child {
  border-bottom: none;
}

.qty-controls {
  display: flex;
  align-items: center;
  gap: 3px;
  background: #202832;
  padding: 2px 4px;
  border-radius: 4px;
  border: 1px solid #2d3743;
}

.qty-btn {
  min-width: 24px;
  min-height: 24px;
  background: transparent;
  border: none;
  color: var(--tux-text);
  cursor: pointer;
  font-weight: 800;
  font-size: 12px;
  border-radius: 3px;
}

.qty-btn:hover {
  background: #303a46;
}

.qty-btn:active {
  background: #3b4653;
}

/* =========================================================
   TOTAL
   ========================================================= */

.total-box {
  background: var(--tux-bg-deep);
  padding: 7px 8px;
  border-radius: 5px;
  margin-bottom: 5px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 800;
  border: 1px solid var(--tux-border);
  flex-shrink: 0;
}

.total-price {
  color: var(--tux-red);
  font-size: 15px;
  font-weight: 900;
}

/* =========================================================
   PAYMENTS
   ========================================================= */

.payments {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 5px;
  margin-bottom: 5px;
  flex-shrink: 0;
}

.payments label {
  font-size: 10px;
  font-weight: 800;
  display: block;
  color: var(--tux-text-soft);
  margin-bottom: 3px;
}

.payments input {
  width: 100%;
  min-height: 30px;
  padding: 5px 6px;
  background: var(--tux-input);
  border: 1px solid var(--tux-border);
  border-radius: 4px;
  color: var(--tux-text);
  font-size: 11px;
  font-weight: 700;
  text-align: center;
  outline: none;
}

.payments input:focus {
  border-color: var(--tux-red);
  box-shadow: 0 0 0 2px rgba(229, 72, 77, 0.1);
}

/* =========================================================
   ACTION BUTTONS
   ========================================================= */

.action-row {
  display: flex;
  gap: 5px;
  margin-bottom: 5px;
  flex-shrink: 0;
}

.btn-action {
  flex: 1;
  min-height: 34px;
  padding: 7px;
  border: none;
  border-radius: 5px;
  font-weight: 800;
  cursor: pointer;
  color: #fff;
  font-size: 11px;
  transition:
    opacity 0.15s ease,
    transform 0.1s ease,
    filter 0.15s ease;
}

.btn-action:hover {
  filter: brightness(1.08);
}

.btn-action:active {
  transform: translateY(1px);
}

.btn-action:disabled {
  opacity: 0.45;
  cursor: not-allowed;
  filter: none;
}

.btn-cancel {
  background: #3b4653;
}

.btn-send {
  background: var(--tux-red);
  flex: 2;
  box-shadow: 0 3px 10px rgba(229, 72, 77, 0.18);
}

/* =========================================================
   WHATSAPP
   ========================================================= */

.whatsapp-row {
  display: flex;
  gap: 5px;
  margin-bottom: 5px;
  align-items: center;
  flex-shrink: 0;
}

.whatsapp-input {
  flex: 1;
  min-width: 0;
  min-height: 32px;
  padding: 6px 8px;
  background: var(--tux-input);
  border: 1px solid var(--tux-border);
  border-radius: 5px;
  color: var(--tux-text);
  font-size: 10.5px;
  font-weight: 700;
  outline: none;
}

.whatsapp-input:focus {
  border-color: var(--tux-green);
}

.btn-whatsapp {
  min-height: 32px;
  background: #20b957;
  color: white;
  border: none;
  padding: 6px 10px;
  border-radius: 5px;
  font-weight: 800;
  cursor: pointer;
  font-size: 10.5px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  white-space: nowrap;
}

.btn-whatsapp:hover {
  filter: brightness(1.08);
}

.btn-whatsapp:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

/* =========================================================
   BOTTOM TOOLS
   ========================================================= */

.bottom-tools {
  display: flex;
  gap: 5px;
  flex-shrink: 0;
}

.tool-btn {
  background: #171d25;
  border: 1px solid var(--tux-border);
  color: var(--tux-text);
  min-height: 32px;
  padding: 6px 8px;
  border-radius: 5px;
  cursor: pointer;
  font-size: 10px;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 4px;
  width: 100%;
  justify-content: center;
  transition:
    background 0.15s ease,
    border-color 0.15s ease,
    transform 0.1s ease;
}

.tool-btn:hover {
  background: var(--tux-card-hover);
  border-color: var(--tux-border-light);
}

.tool-btn:active {
  transform: translateY(1px);
}

.tool-btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.tool-btn.clear {
  background: #131920;
}

/* =========================================================
   KITCHEN DISPLAY
   ========================================================= */

.kds-container {
  background: var(--tux-panel);
  border-radius: 7px;
  padding: 10px;
  border: 1px solid var(--tux-border);
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
  box-shadow: 0 3px 12px var(--tux-shadow);
}

.kds-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  border-bottom: 1px solid var(--tux-border);
  padding-bottom: 7px;
  flex-shrink: 0;
}

.kds-header h2 {
  margin: 0;
  font-size: 14px;
  color: var(--tux-yellow);
}

.orders-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 10px;
  overflow-y: auto;
  flex-grow: 1;
  min-height: 0;
  padding: 4px;
}

.order-card {
  background: var(--tux-card);
  border: 1px solid var(--tux-border);
  border-radius: 7px;
  padding: 9px;
  display: flex;
  flex-direction: column;
  gap: 7px;
  position: relative;
  box-shadow: 0 3px 10px var(--tux-shadow);
}

.order-card.preparing {
  border-left: 4px solid var(--tux-yellow);
}

.order-card.done {
  border-left: 4px solid var(--tux-green);
  opacity: 0.65;
}

.order-card.cancelled {
  border-left: 4px solid var(--tux-red);
  opacity: 0.45;
}

.oc-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  font-weight: 800;
  border-bottom: 1px solid var(--tux-border);
  padding-bottom: 5px;
}

.oc-items {
  font-size: 10.5px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex-grow: 1;
  max-height: 140px;
  overflow-y: auto;
}

.oc-item-row {
  display: flex;
  justify-content: space-between;
  gap: 5px;
  background: var(--tux-bg-deep);
  padding: 5px 6px;
  border-radius: 4px;
  border: 1px solid var(--tux-border-soft);
}

.oc-status {
  font-size: 9.5px;
  padding: 3px 7px;
  border-radius: 4px;
  font-weight: 800;
  text-align: center;
}

.oc-buttons {
  display: flex;
  gap: 5px;
  margin-top: 4px;
}

.oc-btn {
  flex: 1;
  min-height: 32px;
  padding: 6px;
  border: none;
  border-radius: 4px;
  font-weight: 800;
  cursor: pointer;
  font-size: 10px;
  color: white;
}

.oc-btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.btn-done {
  background: var(--tux-green-dark);
}

.btn-k-cancel {
  background: var(--tux-red-dark);
}

.btn-print {
  background: #2568bd;
}

/* =========================================================
   REPORTS / STOCK
   ========================================================= */

.panel-box {
  background: var(--tux-panel);
  border-radius: 7px;
  padding: 12px;
  border: 1px solid var(--tux-border);
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  gap: 8px;
  overflow-y: auto;
  overflow-x: hidden;
  box-shadow: 0 3px 12px var(--tux-shadow);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 7px;
  margin-bottom: 8px;
}

.stat-card {
  background: var(--tux-card);
  border: 1px solid var(--tux-border);
  padding: 10px;
  border-radius: 6px;
  text-align: center;
}

.stat-card h4 {
  margin: 0 0 4px 0;
  font-size: 10px;
  color: var(--tux-muted);
}

.stat-card span {
  font-size: 14px;
  font-weight: 800;
  color: var(--tux-yellow);
}

/* =========================================================
   TABLES
   ========================================================= */

.stock-table,
.settings-table,
.expenses-table,
.workers-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 11px;
}

.stock-table th,
.stock-table td,
.settings-table th,
.settings-table td,
.expenses-table th,
.expenses-table td,
.workers-table th,
.workers-table td {
  padding: 7px;
  border-bottom: 1px solid var(--tux-border-soft);
  text-align: left;
}

.stock-table th,
.settings-table th,
.expenses-table th,
.workers-table th {
  color: var(--tux-yellow);
  background: #131920;
}

/* =========================================================
   FORMS
   ========================================================= */

.form-group {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin-bottom: 7px;
}

.form-group label {
  font-size: 10px;
  color: var(--tux-text-soft);
  font-weight: 800;
}

.form-group input,
.form-group select {
  min-height: 32px;
  padding: 6px 7px;
  background: var(--tux-input);
  border: 1px solid var(--tux-border);
  border-radius: 5px;
  color: var(--tux-text);
  font-size: 11px;
  outline: none;
}

.form-group input:focus,
.form-group select:focus {
  border-color: var(--tux-red);
  box-shadow: 0 0 0 2px rgba(229, 72, 77, 0.1);
}

.btn-save {
  background: var(--tux-green-dark);
  color: white;
  border: none;
  min-height: 34px;
  padding: 7px 13px;
  border-radius: 5px;
  font-weight: 800;
  cursor: pointer;
  font-size: 11px;
}

.btn-save:hover {
  filter: brightness(1.08);
}

/* =========================================================
   WORKERS
   ========================================================= */

.workers-container {
  background: var(--tux-panel);
  border-radius: 7px;
  padding: 10px;
  height: 100%;
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(260px, 300px) minmax(0, 1fr);
  gap: 10px;
  overflow: hidden;
  border: 1px solid var(--tux-border);
}

.workers-left,
.workers-right {
  background: var(--tux-card);
  border: 1px solid var(--tux-border);
  border-radius: 7px;
  padding: 10px;
  overflow-y: auto;
  min-width: 0;
}

.worker-title {
  color: var(--tux-yellow);
  font-size: 13px;
  font-weight: 800;
  margin: 0 0 10px 0;
  border-bottom: 1px solid var(--tux-border);
  padding-bottom: 7px;
}

.worker-form {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.worker-form label {
  font-size: 10px;
  color: var(--tux-text-soft);
  font-weight: 800;
}

.worker-form input,
.worker-form select {
  width: 100%;
  min-height: 34px;
  padding: 7px;
  background: var(--tux-input);
  border: 1px solid var(--tux-border);
  border-radius: 5px;
  color: white;
  font-size: 11px;
}

.worker-btn-row {
  display: flex;
  gap: 5px;
  margin-top: 4px;
}

.worker-btn {
  flex: 1;
  min-height: 34px;
  border: none;
  border-radius: 5px;
  padding: 7px;
  color: white;
  font-weight: 800;
  cursor: pointer;
  font-size: 10px;
}

.worker-btn-attend {
  background: var(--tux-green-dark);
}

.worker-btn-leave {
  background: #2568bd;
}

.worker-btn-delete {
  background: var(--tux-red-dark);
}

.worker-btn-edit {
  background: #7b50c7;
}

.worker-btn:hover {
  opacity: 0.86;
}

.worker-btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.worker-stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 6px;
  margin-bottom: 8px;
}

.worker-stat {
  background: var(--tux-bg-deep);
  border: 1px solid var(--tux-border);
  border-radius: 6px;
  padding: 8px;
  text-align: center;
}

.worker-stat-title {
  font-size: 9px;
  color: var(--tux-muted);
  margin-bottom: 3px;
}

.worker-stat-value {
  font-size: 13px;
  font-weight: 800;
  color: var(--tux-yellow);
}

.worker-section {
  margin-top: 8px;
  background: var(--tux-bg-deep);
  border: 1px solid var(--tux-border);
  border-radius: 6px;
  padding: 8px;
}

.worker-section h4 {
  margin: 0 0 7px 0;
  color: var(--tux-yellow);
  font-size: 11px;
}

.attendance-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 5px;
  padding: 6px;
  border-bottom: 1px solid var(--tux-border-soft);
  font-size: 10px;
}

.attendance-row:last-child {
  border-bottom: none;
}

.worker-name-cell {
  font-weight: 800;
  color: var(--tux-text);
}

.worker-status-present {
  color: var(--tux-green);
  font-weight: 800;
}

.worker-status-absent {
  color: var(--tux-red);
  font-weight: 800;
}

.worker-status-working {
  color: var(--tux-yellow);
  font-weight: 800;
}

.worker-summary-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 10px;
}

.worker-summary-table th,
.worker-summary-table td {
  padding: 6px;
  border-bottom: 1px solid var(--tux-border-soft);
  text-align: left;
}

.worker-summary-table th {
  color: var(--tux-yellow);
}

.empty-worker {
  text-align: center;
  color: var(--tux-muted-dark);
  padding: 20px;
  font-size: 11px;
}

/* =========================================================
   STAFF LOGIN MODAL
   ========================================================= */

.staff-modal {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(3, 5, 8, 0.82);
  z-index: 9999;
  align-items: center;
  justify-content: center;
  padding: 16px;
}

.staff-modal.active {
  display: flex;
}

.staff-modal-box {
  width: min(360px, 100%);
  background: var(--tux-panel);
  border: 1px solid var(--tux-border-light);
  border-radius: 10px;
  padding: 20px;
  box-shadow: 0 15px 50px var(--tux-shadow-heavy);
}

.staff-modal-box h3 {
  margin: 0 0 12px 0;
  color: var(--tux-yellow);
  text-align: center;
  font-size: 16px;
}

.staff-modal-info {
  text-align: center;
  color: var(--tux-muted);
  font-size: 10px;
  line-height: 1.5;
  margin-bottom: 12px;
}

.staff-password-input {
  width: 100%;
  min-height: 42px;
  padding: 9px 10px;
  background: var(--tux-input);
  border: 1px solid var(--tux-border);
  border-radius: 6px;
  color: white;
  font-size: 14px;
  text-align: center;
  outline: none;
}

.staff-password-input:focus {
  border-color: var(--tux-red);
  box-shadow: 0 0 0 2px rgba(229, 72, 77, 0.1);
}

.staff-modal-buttons {
  display: flex;
  gap: 7px;
  margin-top: 12px;
}

.staff-modal-buttons button {
  flex: 1;
  min-height: 38px;
  border: none;
  border-radius: 6px;
  padding: 8px;
  cursor: pointer;
  font-weight: 800;
  color: white;
}

.staff-modal-login {
  background: var(--tux-green-dark);
}

.staff-modal-logout {
  background: var(--tux-red-dark);
}

.staff-modal-cancel {
  background: #3b4653;
}

.staff-modal-buttons button:hover {
  filter: brightness(1.08);
}

/* =========================================================
   SHIFT CONTROLS
   ========================================================= */

.shift-controls {
  display: flex;
  align-items: center;
  gap: 5px;
  margin-left: 6px;
}

.shift-btn {
  min-height: 32px;
  border: none;
  border-radius: 5px;
  padding: 6px 10px;
  color: white;
  font-size: 10px;
  font-weight: 800;
  cursor: pointer;
  white-space: nowrap;
}

.shift-start {
  background: var(--tux-green-dark);
}

.shift-end {
  background: var(--tux-red-dark);
}

.shift-status {
  font-size: 9px;
  color: var(--tux-muted);
  white-space: nowrap;
}

.shift-history-card {
  background: var(--tux-card);
  border: 1px solid var(--tux-border);
  border-radius: 6px;
  padding: 8px;
  margin-bottom: 5px;
}

.shift-history-card button {
  border: none;
  border-radius: 4px;
  background: #2568bd;
  color: white;
  min-height: 30px;
  padding: 5px 9px;
  cursor: pointer;
  font-size: 9px;
  font-weight: 800;
}

/* =========================================================
   CASHIER READABILITY
   ========================================================= */

#cashier-view .item-name {
  font-size: clamp(9px, 0.72vw, 11px);
  font-weight: 800;
  line-height: 1.1;
  color: var(--tux-text);
}

#cashier-view .item-price {
  font-size: clamp(9px, 0.72vw, 11px);
  font-weight: 800;
  line-height: 1;
  color: var(--tux-yellow);
}

#cashier-view .extras-panel .item-name,
#cashier-view .extras-panel .item-price {
  font-size: 10px;
}

#cashier-view .section-title {
  flex-shrink: 0;
  font-size: 10.5px;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: 0.25px;
}

#cashier-view .order-header h2 {
  font-size: 13px;
  font-weight: 800;
}

#cashier-view .order-header span {
  font-size: 10.5px !important;
  font-weight: 800 !important;
}

#cashier-view .cart-table-header {
  flex-shrink: 0;
  font-size: 10px;
  font-weight: 800;
  line-height: 1.15;
  color: var(--tux-muted);
}

#cashier-view .cart-table-header span,
#cashier-view .cart-item span {
  font-size: 10.5px !important;
}

#cashier-view .cart-item {
  font-size: 10.5px;
  font-weight: 700;
}

#cashier-view .qty-btn {
  font-size: 12px;
  font-weight: 800;
}

#cashier-view .total-box {
  flex-shrink: 0;
  font-size: 12px;
  font-weight: 800;
}

#cashier-view .total-price {
  font-size: 15px;
  font-weight: 800;
}

#cashier-view .payments label {
  font-size: 10px;
  font-weight: 800;
  line-height: 1.15;
  color: var(--tux-text-soft);
}

#cashier-view .payments input {
  font-size: 11px;
  font-weight: 800;
}

#cashier-view #diffText {
  flex-shrink: 0;
  font-size: 10.5px !important;
  font-weight: 800;
  line-height: 1.15;
}

#cashier-view .btn-action {
  font-size: 11px;
  font-weight: 800;
}

#cashier-view .btn-whatsapp {
  font-size: 10.5px;
  font-weight: 800;
}

#cashier-view .tool-btn {
  font-size: 10.5px;
  font-weight: 800;
}

#cashier-view .whatsapp-input {
  font-size: 10.5px;
  font-weight: 700;
}

/* =========================================================
   CASHIER CATEGORY TITLES
   ========================================================= */

#cashier-view .category-title-sandwiches {
  background: #a8323a;
  border-color: #c53c45;
}

#cashier-view .category-title-combos {
  background: #a94f19;
  border-color: #c96627;
}

#cashier-view .category-title-fries {
  background: #b18a18;
  border-color: #d2a623;
}

#cashier-view .category-title-hawawshi {
  background: #75472d;
  border-color: #95603e;
}

#cashier-view .category-title-drinks {
  background: #245f91;
  border-color: #347cb8;
}

#cashier-view .category-title-zalabya {
  background: #85447e;
  border-color: #a65a9d;
}

/* =========================================================
   CASHIER CATEGORY PRODUCT BOXES
   ========================================================= */

#cashier-view .category-sandwiches {
  background: #241417;
  border-color: #653037;
  border-top: 3px solid #e5484d;
}

#cashier-view .category-sandwiches:hover {
  background: #32191c;
  border-color: #8a3d43;
}

#cashier-view .category-combos {
  background: #261a13;
  border-color: #684021;
  border-top: 3px solid #e4772e;
}

#cashier-view .category-combos:hover {
  background: #342117;
  border-color: #8d572b;
}

#cashier-view .category-fries {
  background: #262215;
  border-color: #665522;
  border-top: 3px solid #e5b93f;
}

#cashier-view .category-fries:hover {
  background: #342e19;
  border-color: #8d772d;
}

#cashier-view .category-hawawshi {
  background: #251914;
  border-color: #5f3c2b;
  border-top: 3px solid #a96842;
}

#cashier-view .category-hawawshi:hover {
  background: #332219;
  border-color: #83543a;
}

#cashier-view .category-drinks {
  background: #121d27;
  border-color: #285476;
  border-top: 3px solid #3b9bd8;
}

#cashier-view .category-drinks:hover {
  background: #182a39;
  border-color: #3676a2;
}

#cashier-view .category-extras {
  background: #1d1828;
  border-color: #523b76;
  border-top: 3px solid #9b6cff;
}

#cashier-view .category-extras:hover {
  background: #292039;
  border-color: #7050a5;
}

#cashier-view .category-zalabya {
  background: #241723;
  border-color: #64375d;
  border-top: 3px solid #d866a8;
}

#cashier-view .category-zalabya:hover {
  background: #32202f;
  border-color: #8d4e80;
}

/* =========================================================
   CASHIER CATEGORY LAYOUTS
   ========================================================= */

#cashier-view .combos-grid {
  grid-template-columns: repeat(5, minmax(0, 1fr));
}

#cashier-view .fries-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

#cashier-view .dessert-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

/* =========================================================
   HAWAWSHI + DRINKS
   ========================================================= */

#cashier-view .hawawshi-drinks-row {
  display: flex;
  gap: 5px;
  min-width: 0;
}

#cashier-view .hawawshi-column {
  width: 60%;
  min-width: 0;
}

#cashier-view .drinks-column {
  width: 40%;
  min-width: 0;
}

#cashier-view .hawawshi-column .menu-grid,
#cashier-view .drinks-column .menu-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

/* =========================================================
   EXTRA BOXES
   ========================================================= */

#cashier-view .extras-panel .item-card {
  min-height: 50px;
}

/* =========================================================
   CASHIER VIEW BOARD
   SCROLLING
   ========================================================= */

#cashier-view {
  min-height: 0;
  height: 100%;
  overflow: hidden;
}

#cashier-view .pos-container {
  min-height: 0;
  height: 100%;
  overflow: hidden;
}

#cashier-view .menu-panel {
  min-height: 0;
  height: 100%;
  overflow-y: auto;
  overflow-x: hidden;
}

#cashier-view .right-panel {
  min-height: 0;
  height: 100%;
  overflow: hidden;
}

#cashier-view .menu-panel>* {
  flex-shrink: 0;
}

/* =========================================================
   SHORT DESKTOP SCREEN
   ========================================================= */

@media (min-width: 801px) and (max-height: 850px) {
  #cashier-view .menu-panel {
    gap: 3px;
    padding: 5px;
  }

  #cashier-view .section-title {
    min-height: 23px;
    padding: 3px 7px;
    font-size: 10px;
    margin-top: 1px;
  }

  #cashier-view .menu-grid {
    gap: 3px;
  }

  #cashier-view .item-card {
    min-height: 42px;
    padding: 3px 4px;
    gap: 2px;
  }

  #cashier-view .item-name {
    font-size: 9px;
    line-height: 1.05;
  }

  #cashier-view .item-price {
    font-size: 9px;
    line-height: 1;
  }

  #cashier-view .extras-panel .item-card {
    min-height: 42px;
  }
}

/* =========================================================
   VERY SHORT DESKTOP SCREEN
   ========================================================= */

@media (min-width: 801px) and (max-height: 720px) {
  body {
    padding: 4px;
    gap: 4px;
  }

  .top-nav {
    min-height: 40px;
    padding: 4px 8px;
  }

  .nav-btn {
    min-height: 30px;
    padding: 5px 9px;
    font-size: 10px;
  }

  #cashier-view .menu-panel {
    padding: 4px;
    gap: 2px;
  }

  #cashier-view .section-title {
    min-height: 21px;
    padding: 2px 6px;
    font-size: 9.5px;
  }

  #cashier-view .menu-grid {
    gap: 2px;
  }

  #cashier-view .item-card {
    min-height: 37px;
    padding: 2px 3px;
    gap: 1px;
  }

  #cashier-view .item-name {
    font-size: 8.5px;
    line-height: 1;
  }

  #cashier-view .item-price {
    font-size: 8.5px;
    line-height: 1;
  }

  #cashier-view .extras-panel .item-card {
    min-height: 38px;
  }
}

/* =========================================================
   EMPTY STATE
   ========================================================= */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 90px;
  padding: 20px;
  color: var(--tux-muted-dark);
  text-align: center;
  font-size: 11px;
}

.empty-state strong {
  color: var(--tux-muted);
  font-size: 12px;
  margin-bottom: 4px;
}

/* =========================================================
   ACCESSIBILITY
   ========================================================= */

button:focus-visible,
input:focus-visible,
select:focus-visible {
  outline: 2px solid var(--tux-red);
  outline-offset: 2px;
}

/* =========================================================
   PRINT
   ========================================================= */

#printArea {
  display: none;
}

@media print {
  body>*:not(#printArea) {
    display: none !important;
  }

  #printArea {
    display: block !important;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    background: #ffffff !important;
    color: #000000 !important;
    padding: 15px;
    font-size: 14px;
    font-family: monospace;
  }
}

/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1100px) {
  body {
    padding: 5px;
  }

  .top-nav {
    flex-wrap: wrap;
    min-height: auto;
  }

  .nav-tabs {
    order: 3;
    width: 100%;
    overflow-x: auto;
    flex-wrap: nowrap;
    padding-bottom: 2px;
  }

  .nav-btn {
    flex: 0 0 auto;
  }

  .nav-clock {
    margin-left: auto;
  }

  .pos-container {
    gap: 5px;
  }

  .menu-panel {
    width: 62%;
  }

  .right-panel {
    width: 38%;
    min-width: 280px;
  }

  .menu-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  }

  .item-card {
    min-height: 58px;
  }

  .stats-grid,
  .worker-stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* =========================================================
   SMALL TABLET
   ========================================================= */

@media (max-width: 800px) {
  body {
    overflow-y: auto;
    overflow-x: hidden;
    height: auto;
    min-height: 100%;
  }

  .view-section {
    overflow: visible;
    min-height: 0;
    height: auto;
  }

  .pos-container {
    flex-direction: column;
    height: auto;
    overflow: visible;
  }

  .menu-panel,
  .right-panel {
    width: 100%;
    min-width: 0;
  }

  .menu-panel {
    max-height: none;
    height: auto;
    overflow: visible;
  }

  .right-panel {
    height: auto;
    overflow: visible;
  }

  .extras-panel {
    max-height: none;
  }

  .order-panel {
    min-height: 500px;
  }

  #cashier-view {
    height: auto;
    overflow: visible;
  }

  #cashier-view .pos-container {
    height: auto;
    overflow: visible;
  }

  #cashier-view .menu-panel {
    height: auto;
    overflow: visible;
  }

  #cashier-view .right-panel {
    height: auto;
    overflow: visible;
  }

  #cashier-view .hawawshi-drinks-row {
    flex-direction: column;
  }

  #cashier-view .hawawshi-column,
  #cashier-view .drinks-column {
    width: 100%;
  }

  #cashier-view .combos-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  #cashier-view .fries-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  #cashier-view .dessert-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .workers-container {
    grid-template-columns: 1fr;
    height: auto;
    overflow: visible;
  }

  .workers-left,
  .workers-right {
    max-height: none;
  }
}

/* =========================================================
   PHONE
   ========================================================= */

@media (max-width: 600px) {
  body {
    padding: 4px;
    gap: 5px;
  }

  .top-nav {
    padding: 6px;
    gap: 6px;
  }

  .nav-brand {
    font-size: 14px;
  }

  .staff-login-box {
    max-width: 100%;
  }

  .staff-status {
    max-width: 120px;
  }

  .nav-clock {
    display: none;
  }

  .nav-tabs {
    gap: 3px;
  }

  .nav-btn {
    min-height: 36px;
    padding: 7px 9px;
    font-size: 10px;
  }

  .menu-panel {
    padding: 6px;
  }

  .menu-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 5px;
  }

  .item-card {
    min-height: 62px;
    padding: 8px 5px;
  }

  .section-title {
    min-height: 30px;
    font-size: 11px;
  }

  .payments {
    grid-template-columns: 1fr 1fr;
  }

  .action-row {
    flex-direction: column;
  }

  .btn-action,
  .btn-send {
    width: 100%;
    flex: none;
  }

  .whatsapp-row {
    flex-direction: column;
    align-items: stretch;
  }

  .whatsapp-input,
  .btn-whatsapp {
    width: 100%;
  }

  .bottom-tools {
    flex-wrap: wrap;
  }

  .tool-btn {
    min-width: calc(50% - 3px);
  }

  .stats-grid,
  .worker-stats-grid {
    grid-template-columns: 1fr 1fr;
  }

  .panel-box {
    padding: 8px;
  }

  .workers-container {
    padding: 6px;
  }

  .worker-btn-row {
    flex-direction: column;
  }
}

/* =========================================================
   VERY SMALL PHONE
   ========================================================= */

@media (max-width: 400px) {
  .menu-grid {
    grid-template-columns: 1fr 1fr !important;
  }

  .item-card {
    min-height: 58px;
  }

  .cart-item {
    font-size: 10px;
  }

  .payments {
    grid-template-columns: 1fr;
  }

  .staff-modal-box {
    padding: 16px;
  }
}

/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition: none !important;
    animation: none !important;
  }
}